<section class="section-form">
    <div class="container">
        <a href="/admin" class="back-link">&larr; До адмін-панелі</a>

        <h1 class="page-title">📊 Ввести результат</h1>

        <div class="result-match-info">
            <span><%= game.team1.logo %> <strong><%= game.team1.name %></strong></span>
            <span class="result-vs">VS</span>
            <span><%= game.team2.logo %> <strong><%= game.team2.name %></strong></span>
        </div>

        <form action="/admin/result/<%= game.id %>" method="POST" class="admin-form result-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="team1Score" class="form-label"><%= game.team1.name %></label>
                    <input type="number" id="team1Score" name="team1Score" class="form-input" min="0" 
                        value="<%= game.result ? game.result.team1Score : '' %>" required />
                </div>

                <span class="form-colon">:</span>

                <div class="form-group">
                    <label for="team2Score" class="form-label"><%= game.team2.name %></label>
                    <input type="number" id="team2Score" name="team2Score" class="form-input" min="0" 
                        value="<%= game.result ? game.result.team2Score : '' %>" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Зберегти результат</button>
        </form>
    </div>
</section>
